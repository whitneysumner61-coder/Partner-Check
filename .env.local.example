# =====================================
# Frontend Configuration (Vite/React)
# =====================================

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Application URL
VITE_APP_URL=http://localhost:5173

# Gemini AI API Key (existing)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Claude API Key (claudeService.ts)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── Claudex (free, open-source, no API key needed) ──────────────────────────
#
# LOCAL (default):
#   brew install ollama  OR  curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull deepseek-r1 && ollama pull qwen2.5-coder
#   ollama serve
#
# CLOUD VM (RunPod / Vast.ai / any VPS):
#   1. Install Ollama on VM:  curl -fsSL https://ollama.com/install.sh | sh
#   2. Pull models:           ollama pull deepseek-r1 && ollama pull qwen2.5-coder
#   3. Allow remote access:   export OLLAMA_HOST=0.0.0.0:11434
#                             export OLLAMA_ORIGINS=*
#   4. Start server:          ollama serve
#   5. Open port 11434 in your VM firewall / security group
#   6. Set the URL below to your VM's public IP
#
# Model size presets:
#   Mini  → VITE_CLAUDEX_REASON_MODEL=deepseek-r1:1.5b  VITE_CLAUDEX_CODER_MODEL=qwen2.5-coder:1.5b
#   Bal   → (defaults below — 7B each)
#   Max   → VITE_CLAUDEX_REASON_MODEL=deepseek-r1:70b   VITE_CLAUDEX_CODER_MODEL=qwen2.5-coder:32b

VITE_OLLAMA_BASE_URL=http://localhost:11434/v1   # swap <localhost> for cloud VM IP
VITE_CLAUDEX_REASON_MODEL=deepseek-r1            # reasoning engine
VITE_CLAUDEX_CODER_MODEL=qwen2.5-coder           # structured-output engine

# =====================================
# Autopilot YouTube Factory (Python)
# =====================================

# Server Configuration
AUTOPILOT_DB=./autopilot.db
AUTOPILOT_STORAGE=./storage
AUTOPILOT_BASE_URL=http://127.0.0.1:8787

# Governance & Security
# IMPORTANT: Change this to a secure 32+ byte random string in production!
AUTOPILOT_APP_KEY=change-me-please-32bytes-min
AUTOPILOT_MAX_PUBLISH_PER_DAY=1
AUTOPILOT_MAX_RENDERS_PER_JOB=2

# YouTube API Configuration
# Category 22 = "People & Blogs" - see https://developers.google.com/youtube/v3/docs/videoCategories/list
AUTOPILOT_YT_CATEGORY_ID=22
AUTOPILOT_OAUTH_CLIENT_SECRETS=./client_secrets.json
AUTOPILOT_OAUTH_TOKEN_FILE=./oauth_token.json
